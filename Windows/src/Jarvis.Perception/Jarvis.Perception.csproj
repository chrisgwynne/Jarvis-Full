<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Jarvis.Perception</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Required so the Windows SDK projections (Windows.Media.Ocr, Windows.Graphics.Imaging) are available. -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Jarvis.Core\Jarvis.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <!-- System.Drawing for ScreenshotWindowTool (GDI CopyFromScreen). On .NET 8 Windows
         UseWPF=true typically brings this in via the Windows Desktop workload, but
         the explicit reference ensures deterministic resolution across CI configurations. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Jarvis.Perception.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- System.Windows.Automation namespace (AutomationElement, TextPattern, ...) ships in
         UIAutomationClient.dll, which the WindowsDesktop framework reference includes when
         <UseWPF> is true. No explicit <Reference> needed on .NET 8. -->
  </ItemGroup>
</Project>
