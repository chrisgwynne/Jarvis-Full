<Window x:Class="Jarvis.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis Settings"
        Width="480" Height="640"
        MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1F"
        Foreground="#E6E8EE"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#9DA4B0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reset to defaults" Click="OnResetClicked"/>
            <Button Content="Cancel" Click="OnCancelClicked"/>
            <Button Content="Save" Click="OnSaveClicked" IsDefault="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Header="Pebble">
                    <StackPanel>
                        <TextBlock Text="Size"/>
                        <Slider x:Name="SizeSlider" Minimum="20" Maximum="120" TickFrequency="2" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Opacity"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"/>
                        <TextBlock Text="Follow easing (lower = smoother trail)"/>
                        <Slider x:Name="EasingSlider" Minimum="0.05" Maximum="1.0" SmallChange="0.01" LargeChange="0.05"/>
                        <CheckBox x:Name="FollowCursorCheck" Content="Follow cursor"/>
                        <CheckBox x:Name="AnimationsCheck" Content="Animations enabled"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Overlay">
                    <StackPanel>
                        <CheckBox x:Name="ClickThroughCheck" Content="Click-through (input passes underneath)"/>
                        <CheckBox x:Name="AlwaysOnTopCheck" Content="Always on top"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Mac brain gateway (over Tailscale)">
                    <StackPanel>
                        <!-- ── Gateway config (Phase 2) ──────────────────────── -->
                        <TextBlock Text="Mac Brain Gateway URL"
                                   ToolTip="HTTP base URL of the Mac Brain Daemon — e.g. http://100.64.1.5:8765 or http://mac.tail-xxxxx.ts.net:8765. Find your Mac Tailscale IP via: tailscale ip -4"/>
                        <TextBox x:Name="GatewayBaseUrlBox" Margin="0,2,0,2"/>
                        <TextBlock Margin="0,0,0,6" FontSize="11" Foreground="#9DA4B0"
                                   TextWrapping="Wrap"
                                   Text="Use your Mac's Tailscale IP or MagicDNS hostname on port 8765 (e.g. http://100.64.1.5:8765). Both machines must be on the same Tailscale tailnet."/>

                        <!-- ── Pairing flow ──────────────────────────────────── -->
                        <Border Background="#1A1A2A" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock x:Name="PairingStatusText" FontSize="12" Foreground="#9DA4B0"
                                           TextWrapping="Wrap" Text="Not paired"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBox x:Name="PairingCodeBox" MinWidth="120" Margin="0,0,6,0"
                                             Tag="Pairing code from Mac Brain"/>
                                    <Button x:Name="PairButton" Content="Pair with Mac"
                                            Click="OnPairClicked" MinWidth="100"/>
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#9DA4B0"
                                           TextWrapping="Wrap"
                                           Text="On Mac Brain: open Settings → Windows Devices → Show pairing code. Enter the 6-digit code above and click Pair."/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="AutoReconnectCheck"
                                  Content="Auto-reconnect if the bridge drops"/>
                        <CheckBox x:Name="OfflineDegradedCheck"
                                  Content="Allow local LLM fallback when Mac is unreachable"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <Button x:Name="TestBridgeButton" Content="Test connection"
                                    Click="OnTestBridgeClicked" MinWidth="110" Margin="0"/>
                            <Button x:Name="SendTestTranscriptButton" Content="Send test transcript"
                                    Click="OnSendTestTranscriptClicked" MinWidth="140" IsEnabled="False"/>
                            <Button x:Name="RequestMacTestButton" Content="Request Mac test"
                                    Click="OnRequestMacTestClicked" MinWidth="120" IsEnabled="False"/>
                        </StackPanel>
                        <TextBox x:Name="TestBridgeOutput" IsReadOnly="True"
                                 TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"
                                 Height="90" Margin="0,4,0,4"
                                 Background="#12121A" Foreground="#9DA4B0" BorderBrush="#2A2A3A"
                                 VerticalScrollBarVisibility="Auto" Text=""
                                 AcceptsReturn="True" IsTabStop="False"/>

                        <!-- ── Legacy settings (hidden when gateway is configured) ── -->
                        <Expander x:Name="LegacyBridgeExpander" Header="Legacy bridge settings (v1)"
                                  Margin="0,4,0,0" Foreground="#9DA4B0" FontSize="11">
                            <StackPanel Margin="0,4,0,0">
                                <CheckBox x:Name="SidecarEnabledCheck"
                                          Content="Enable legacy Mac bridge (used when Gateway URL is empty)"/>
                                <TextBlock Text="Brain WebSocket URL"/>
                                <TextBox x:Name="BridgeUrlBox" Margin="0,2,0,2"/>
                                <TextBlock Text="Bearer token"/>
                                <PasswordBox x:Name="BridgeTokenBox" Margin="0,2,0,6"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Voice + wake word">
                    <StackPanel>
                        <CheckBox x:Name="WakeWordEnabledCheck"
                                  Content="Listen for wake word"/>
                        <TextBlock Text="Local wake alias (this device only — not the assistant name)"/>
                        <TextBox x:Name="LocalWakeAliasBox" Margin="0,2,0,6"/>
                        <TextBlock Text="Device name (shown to the Mac brain in attribution)"/>
                        <TextBox x:Name="DeviceNameBox" Margin="0,2,0,6"/>
                        <CheckBox x:Name="LocalTtsEnabledCheck"
                                  Content="Allow local TTS (Mac must grant lease before speaking)"/>
                        <CheckBox x:Name="PrivacyModeCheck"
                                  Content="Privacy mode (mute mic + suppress context push)"/>
                        <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="#9DA4B0"
                                   TextWrapping="Wrap"
                                   Text="Say the alias above to wake the local mic. The Mac brain still owns the conversation — the alias is only a per-device trigger."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Pebble menu (middle mouse button)">
                    <StackPanel>
                        <CheckBox x:Name="MouseChordEnabledCheck"
                                  Content="Enable middle-click menu"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Performance">
                    <StackPanel>
                        <CheckBox x:Name="ReducedMotionCheck" Content="Reduced motion"/>
                        <CheckBox x:Name="RespectBatteryCheck" Content="Respect battery saver"/>
                        <CheckBox x:Name="GpuAccelCheck" Content="GPU acceleration (restart required)"/>
                        <CheckBox x:Name="PerfHudCheck" Content="Show performance HUD"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
