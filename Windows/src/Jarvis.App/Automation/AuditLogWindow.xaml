<Window x:Class="Jarvis.App.Automation.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis · audit log"
        Width="900" Height="640"
        Background="#0F1117"
        Foreground="#E6E8EE"
        FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6E8EE"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,0,8,0"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="6,0,0,0"/></Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Tier" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="TierFilter" Width="120" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="any" IsSelected="True"/>
                <ComboBoxItem Content="Safe"/>
                <ComboBoxItem Content="Confirm"/>
                <ComboBoxItem Content="Approve"/>
                <ComboBoxItem Content="Block"/>
            </ComboBox>
            <TextBlock Text="Outcome" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="OutcomeFilter" Width="160" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="any" IsSelected="True"/>
                <ComboBoxItem Content="Succeeded"/>
                <ComboBoxItem Content="Failed"/>
                <ComboBoxItem Content="DeniedByPolicy"/>
                <ComboBoxItem Content="CancelledByUser"/>
                <ComboBoxItem Content="TimedOut"/>
                <ComboBoxItem Content="DryRunOnly"/>
            </ComboBox>
            <Button Content="Refresh" Click="OnRefresh"/>
            <Button Content="Open folder" Click="OnOpenFolder"/>
            <Button Content="Copy selected JSON" Click="OnCopyJson"/>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#0F1117" Foreground="#E6E8EE" RowBackground="#11151D" AlternatingRowBackground="#161A23"
                  GridLinesVisibility="None" BorderThickness="0" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="At (UTC)" Binding="{Binding At, StringFormat=HH:mm:ss}" Width="80"/>
                <DataGridTextColumn Header="Intent" Binding="{Binding IntentKind}" Width="160"/>
                <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="80"/>
                <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="120"/>
                <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMs, StringFormat=F1}" Width="100"/>
                <DataGridTextColumn Header="Summary" Binding="{Binding IntentSummary}" Width="*"/>
                <DataGridTextColumn Header="Approver" Binding="{Binding Approver}" Width="120"/>
                <DataGridTextColumn Header="Policy" Binding="{Binding PolicyVersion}" Width="100"/>
                <DataGridTextColumn Header="Plan #" Binding="{Binding DryRunHash}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
