<Window x:Class="Jarvis.App.Automation.HighlightOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        IsHitTestVisible="False"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Title="Jarvis highlight">
    <Canvas x:Name="Root" Background="Transparent">
        <Rectangle x:Name="HighlightRect"
                   Stroke="#FF6FA8FF" StrokeThickness="2"
                   Fill="#226FA8FF"
                   RadiusX="3" RadiusY="3">
            <Rectangle.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#6FA8FF" Opacity="0.7"/>
            </Rectangle.Effect>
        </Rectangle>
        <TextBlock x:Name="LabelText" Foreground="#E6E8EE"
                   FontFamily="Segoe UI" FontSize="11"
                   Background="#CC0F1117" Padding="6,2"/>
    </Canvas>
</Window>
