<Window x:Class="Jarvis.App.Automation.ApprovalPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis · approval required"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#0F1117"
        Foreground="#E6E8EE"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E8EE"/>
        </Style>
        <Style x:Key="K" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8AA6CC"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="V" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="ui-monospace, Consolas, monospace"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock x:Name="Headline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <TextBlock Style="{StaticResource K}" Text="Safety tier"/>
        <TextBlock x:Name="TierText" Style="{StaticResource V}"/>

        <TextBlock Style="{StaticResource K}" Text="What will happen"/>
        <ItemsControl x:Name="StepsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Style="{StaticResource V}" Text="{Binding}" Margin="0,1,0,1"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource K}" Text="Target"/>
        <TextBlock x:Name="TargetText" Style="{StaticResource V}"/>

        <TextBlock Style="{StaticResource K}" Text="How to undo"/>
        <TextBlock x:Name="UndoText" Style="{StaticResource V}"/>

        <TextBlock x:Name="CountdownText" Margin="0,14,0,0" Foreground="#8AA6CC" FontSize="11"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DenyBtn" Content="Deny" Click="OnDeny" IsCancel="True"/>
            <Button x:Name="ApproveBtn" Content="Approve" Click="OnApprove" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
