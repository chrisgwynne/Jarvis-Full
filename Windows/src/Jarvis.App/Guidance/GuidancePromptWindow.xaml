<Window x:Class="Jarvis.App.Guidance.GuidancePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis · where do I click?"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#0F1117"
        Foreground="#E6E8EE"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6E8EE"/></Style>
        <Style x:Key="K" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8AA6CC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="V" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="ui-monospace, Consolas, monospace"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#151823"/>
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="BorderBrush" Value="#29314A"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Where do I click?"/>
        <TextBlock Style="{StaticResource K}" Text="Ask in plain language. Example: &quot;save this&quot;, &quot;continue&quot;, &quot;create new repo&quot;."/>
        <TextBox x:Name="QueryBox" Margin="0,6,0,0" KeyDown="OnQueryKeyDown"/>

        <TextBlock Style="{StaticResource K}" Text="Result"/>
        <TextBlock x:Name="ResultText" Style="{StaticResource V}" Text="—"/>

        <TextBlock Style="{StaticResource K}" Text="Top candidates"/>
        <ItemsControl x:Name="CandidatesList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Style="{StaticResource V}" Margin="0,1,0,1"
                               Text="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <CheckBox x:Name="KeepOpenCheck" Content="Keep open" Margin="0,6,12,0"
                      Foreground="#8AA6CC" VerticalAlignment="Center"
                      ToolTip="When off, the prompt parks in the corner after a successful query so it doesn't cover the highlighted target."/>
            <Button Content="Close" IsCancel="True" Click="OnClose"/>
            <Button x:Name="ClickItBtn" Content="Click it" Click="OnClickIt" IsEnabled="False"/>
            <Button Content="Ask" Click="OnAsk" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
