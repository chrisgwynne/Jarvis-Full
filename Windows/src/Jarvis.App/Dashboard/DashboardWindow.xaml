<Window x:Class="Jarvis.App.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis Dashboard"
        Background="#1A1A1F"
        Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Width="460"
        Height="640"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,8,0,16">

            <!-- Card 1: Jarvis Status -->
            <Border CornerRadius="12" Background="#242429" Margin="16,8" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="JARVIS STATUS"
                               FontSize="11" Foreground="#888" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusIndicator"
                                 Width="8" Height="8"
                                 Fill="#22C55E"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="PresenceModeText"
                                   FontSize="22" FontWeight="Medium"
                                   Text="Work"/>
                    </StackPanel>
                    <TextBlock x:Name="BridgeStatusText"
                               FontSize="13" Foreground="#B0B0B8"
                               Margin="0,6,0,0"
                               Text="Mac: Disconnected"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Focus Session -->
            <Border CornerRadius="12" Background="#242429" Margin="16,8" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="FOCUS SESSION"
                               FontSize="11" Foreground="#888" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FocusDurationText"
                                   FontSize="22" FontWeight="Medium"
                                   Text="0 min"/>
                        <TextBlock x:Name="FocusStateText"
                                   FontSize="13" Foreground="#B0B0B8"
                                   Margin="12,4,0,0"
                                   VerticalAlignment="Bottom"
                                   Text="Working"/>
                    </StackPanel>
                    <!-- Productivity score bar -->
                    <Grid Margin="0,10,0,4" Height="6">
                        <Rectangle Fill="#333338" RadiusX="3" RadiusY="3"/>
                        <Rectangle x:Name="ProductivityBar"
                                   Fill="#3B82F6" RadiusX="3" RadiusY="3"
                                   HorizontalAlignment="Left"
                                   Width="0"/>
                    </Grid>
                    <TextBlock x:Name="ProductivityScoreText"
                               FontSize="13" Foreground="#B0B0B8"
                               Text="Productivity: 0%"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Activity -->
            <Border CornerRadius="12" Background="#242429" Margin="16,8" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="ACTIVITY"
                               FontSize="11" Foreground="#888" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="WorkflowText"
                               FontSize="22" FontWeight="Medium"
                               Text="Unknown"/>
                    <TextBlock x:Name="AppSwitchesText"
                               FontSize="13" Foreground="#B0B0B8"
                               Margin="0,6,0,0"
                               Text="0 app switches in last 10 min"/>
                    <TextBlock x:Name="SmartSuggestionText"
                               FontSize="13" Foreground="#F59E0B"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text=""
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Today -->
            <Border CornerRadius="12" Background="#242429" Margin="16,8" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="TODAY"
                               FontSize="11" Foreground="#888" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="TimelineSummaryText"
                               FontSize="13" Foreground="#B0B0B8"
                               TextWrapping="Wrap"
                               Text="Session tracking initializing..."/>
                </StackPanel>
            </Border>

            <!-- Card 5: Device Health -->
            <Border CornerRadius="12" Background="#242429" Margin="16,8" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="DEVICE HEALTH"
                               FontSize="11" Foreground="#888" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="MacConnectionText"
                               FontSize="22" FontWeight="Medium"
                               Text="Mac Disconnected"/>
                    <TextBlock x:Name="BridgeLatencyText"
                               FontSize="13" Foreground="#B0B0B8"
                               Margin="0,6,0,0"
                               Text="Bridge latency: —"/>
                </StackPanel>
            </Border>

            <!-- Card 6: Quick Actions -->
            <Border CornerRadius="12" Background="#242429" Margin="16,8" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="QUICK ACTIONS"
                               FontSize="11" Foreground="#888" FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button x:Name="FocusModeBtn"
                                Content="Focus Mode"
                                Click="OnFocusModeBtn"
                                Margin="0,0,8,8"
                                Padding="14,8"
                                FontSize="13"
                                Background="#3B82F6"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#2563EB"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#1D4ED8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="ScreenshotBtn"
                                Content="Screenshot"
                                Click="OnScreenshotBtn"
                                Margin="0,0,8,8"
                                Padding="14,8"
                                FontSize="13">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#374151"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4B5563"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="RunningAppsBtn"
                                Content="Running Apps"
                                Click="OnRunningAppsBtn"
                                Margin="0,0,8,8"
                                Padding="14,8"
                                FontSize="13">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#374151"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4B5563"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Card 7: Recent Tool Runs -->
            <Border x:Name="RecentToolRunsCard"
                    CornerRadius="12" Background="#242429" Margin="16,8" Padding="20,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="RECENT ACTIONS"
                               FontSize="11" Foreground="#888" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <ItemsControl x:Name="RecentToolRunsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StatusGlyph}"
                                               FontSize="11"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Summary}"
                                               FontSize="12" Foreground="#D1D5DB"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TimeDisplay}"
                                               FontSize="11" Foreground="#6B7280"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
