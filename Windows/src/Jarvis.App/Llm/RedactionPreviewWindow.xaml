<Window x:Class="Jarvis.App.Llm.RedactionPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis · redaction preview"
        Width="720" Height="560"
        Background="#0F1117" Foreground="#E6E8EE"
        FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Copy redacted" Padding="10,4" Margin="6,0,0,0" Click="OnCopyRedacted"/>
            <Button Content="Close" Padding="10,4" Margin="6,0,0,0" IsCancel="True" Click="OnClose"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Foreground="#8AA6CC" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8">
                Shows what the redactor produced from the most recent turn's context. The
                original (unredacted) bodies are <Bold>never</Bold> displayed here — that's
                the whole point. Use this view to verify that secrets are getting caught.
            </TextBlock>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#151823" BorderBrush="#29314A" BorderThickness="1" CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="RedactedText" Background="Transparent" Foreground="#E6E8EE"
                                 BorderThickness="0" IsReadOnly="True"
                                 FontFamily="ui-monospace, Consolas, monospace" FontSize="11"
                                 TextWrapping="Wrap" AcceptsReturn="True" Padding="10"/>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" Background="#151823" BorderBrush="#29314A" BorderThickness="1"
                        CornerRadius="4" Margin="8,0,0,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Counts by category" Foreground="#8AA6CC" FontSize="11" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="CategoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontFamily="ui-monospace, Consolas, monospace"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyHint" Foreground="#8AA6CC" FontSize="11" Margin="0,12,0,0" Text="(no replacements in the last turn)"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
