<Window x:Class="Jarvis.App.Llm.LlmSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis · LLM &amp; redaction"
        Width="520" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117" Foreground="#E6E8EE"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6E8EE"/></Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#8AA6CC"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#151823"/>
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="BorderBrush" Value="#29314A"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#151823"/>
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="BorderBrush" Value="#29314A"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="88"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Test connection" Click="OnTest"/>
            <Button Content="Cancel" Click="OnCancel" IsCancel="True"/>
            <Button Content="Save &amp; reload" Click="OnSave" IsDefault="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Provider">
                    <StackPanel>
                        <TextBlock Text="Provider"/>
                        <ComboBox x:Name="ProviderCombo" SelectionChanged="OnProviderChanged">
                            <ComboBoxItem Content="None (echo stub)"/>
                            <ComboBoxItem Content="OpenAI-compatible"/>
                            <ComboBoxItem Content="Ollama"/>
                            <ComboBoxItem Content="MiniMax"/>
                        </ComboBox>

                        <TextBlock Text="API key"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0" x:Name="ApiKeyBox"/>
                            <TextBox    Grid.Column="0" x:Name="ApiKeyText" Visibility="Collapsed"/>
                            <Button    Grid.Column="1" x:Name="RevealBtn" Content="Reveal" Click="OnToggleReveal"/>
                        </Grid>

                        <TextBlock Text="Base URL (override)"/>
                        <TextBox x:Name="BaseUrlBox"/>

                        <TextBlock Text="Model"/>
                        <TextBox x:Name="ModelBox"/>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Temperature"/>
                                <TextBox x:Name="TempBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Max tokens"/>
                                <TextBox x:Name="MaxTokensBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Timeout (s)"/>
                                <TextBox x:Name="TimeoutBox"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="StreamCheck" Content="Stream responses"/>
                        <CheckBox x:Name="ContextInjectionCheck" Content="Inject desktop context into LLM calls"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Redaction (before context leaves the machine)">
                    <StackPanel>
                        <CheckBox x:Name="RedactionEnabledCheck" Content="Enabled"/>
                        <CheckBox x:Name="RedactEmailsCheck" Content="Redact email addresses"/>
                        <CheckBox x:Name="RedactPhonesCheck" Content="Redact phone numbers"/>
                        <CheckBox x:Name="RedactPathsCheck" Content="Redact local file paths"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Max selection chars"/>
                                <TextBox x:Name="MaxSelChars"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Max clipboard chars"/>
                                <TextBox x:Name="MaxClipChars"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max OCR chars"/>
                                <TextBox x:Name="MaxOcrChars"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Daily quota">
                    <StackPanel>
                        <CheckBox x:Name="QuotaEnabledCheck" Content="Enforce daily quota"/>
                        <CheckBox x:Name="QuotaExemptLocalCheck" Content="Exempt local providers (Ollama / stub)"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Max requests / day"/>
                                <TextBox x:Name="MaxReqs"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Max chars / day"/>
                                <TextBox x:Name="MaxChars"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <TextBlock x:Name="StatusText" Foreground="#8AA6CC" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
