<Window x:Class="Jarvis.App.Chat.ChatPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis"
        Width="440" Height="540"
        Background="#0F1117"
        Foreground="#E6E8EE"
        FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResize"
        WindowStyle="ToolWindow">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6E8EE"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="64"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#151823"/>
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="BorderBrush" Value="#29314A"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="Jarvis" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="ProviderText" Foreground="#8AA6CC" FontSize="10"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="StatusText" Foreground="#8AA6CC" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="RetryBtn" Content="Retry" Click="OnRetry" IsEnabled="False"/>
                <Button Content="Clear" Click="OnClear"/>
                <Button x:Name="MinimiseBtn" Content="Minimise" Click="OnMinimise"/>
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="InputBox"
                     KeyDown="OnInputKeyDown" AcceptsReturn="False"/>
            <Button Grid.Column="1" x:Name="StopBtn" Content="Stop" Click="OnStop" IsEnabled="False"/>
            <Button Grid.Column="2" Content="Send" Click="OnSend" IsDefault="True"/>
        </Grid>

        <ScrollViewer x:Name="ScrollView" VerticalScrollBarVisibility="Auto">
            <Grid>
                <TextBlock x:Name="EmptyHint" Foreground="#8AA6CC" FontSize="11" TextAlignment="Center"
                           Margin="0,60,0,0" TextWrapping="Wrap"
                           Text="Ask in plain language. Try: &quot;what app am I in&quot;, &quot;where do I click to save&quot;, &quot;ocr this&quot;, or anything else."/>
                <ItemsControl x:Name="MessagesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="10,8" Margin="0,4,0,4"
                                Background="{Binding Brush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding RoleLabel}" Foreground="#8AA6CC" FontSize="10"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontFamily="Segoe UI">
                                        <Run Text="{Binding Content}"/>
                                        <Run Text="{Binding Caret}" Foreground="#6FA8FF"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Copy" Padding="6,1" Margin="6,0,0,0"
                                        VerticalAlignment="Top" Tag="{Binding}" Click="OnCopyRow"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
