<Window x:Class="Jarvis.App.Chord.PebbleInteractionMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pebble Menu"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown"
        Focusable="True">
    <Border CornerRadius="10"
            Background="#E61A2336"
            BorderBrush="#3F8AB4FF"
            BorderThickness="1"
            Padding="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel x:Name="MenuItems" Orientation="Vertical" Width="220"/>
    </Border>
</Window>
