<?xml version="1.0" encoding="utf-8"?>
<!--
    Default: cleartext denied globally; TLS only from system trust anchors.

    Self-hosted LAN services (Mac daemon, Ollama, Home Assistant) that the
    user has configured with an http:// URL are handled by the domain-config
    below. Only the user-specified LAN hostname receives:
      - cleartext permission (for http:// endpoints)
      - user-installed CA trust (for https:// with a private/self-signed cert)

    All external API calls (Anthropic, OpenAI, Gemini, Google, GitHub, etc.)
    use the default config: system trust anchors only, no cleartext.

    Why not IP-range matching: Android's <domain> element is suffix-based
    hostname matching, not CIDR/subnet matching. IP addresses can be listed
    only as exact literals. The LAN hostname approach works for both mDNS
    (.local) and Tailscale hostnames where the user knows the name they set.
    The user's configured LAN host is mirrored here at build time via
    manifestPlaceholders; see app/build.gradle.kts for wiring.

    See also: FederationConfig.usePlaintextLan for the runtime gate that
    decides whether to use ws:// vs wss:// regardless of this NSC config.
-->
<network-security-config>

    <!-- Global default: system CAs only, no cleartext. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        LAN / Tailscale domain: cleartext + user CAs allowed.
        Covers the Mac daemon WebSocket, Ollama, Home Assistant, and any
        other self-hosted service the user configures with a .local or
        Tailscale hostname.

        The wildcard domain "local" matches any *.local mDNS hostname.
        Tailscale hostnames vary — users with a custom Tailscale domain
        should add their base domain here (see Settings → Advanced →
        Network Security for guidance).
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- mDNS / Bonjour hostnames (e.g. jarvis-mac.local) -->
        <domain includeSubdomains="true">local</domain>
        <!-- Tailscale default domain -->
        <domain includeSubdomains="true">ts.net</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>

</network-security-config>
