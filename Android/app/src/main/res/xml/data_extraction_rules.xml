<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup + device-transfer policy for Jarvis.

    WHAT SYNCS
      Only the non-encrypted SharedPreferences stores used by the
      presence / learning layer (known SSIDs, action ledger, conversation
      thread metadata, routine synth). These contain no message bodies,
      contacts, transcripts, location, or biometric data.

    WHAT DOES NOT (and why)
      * The Room database (jarvis.db) is EXCLUDED. It stores conversation
        transcripts/summaries, memory facts (user name, home/work
        location), knowledge, reminders, and speaker voice embeddings
        (biometric). These must not leave the device in cleartext via
        Google cloud backup or device transfer. The DB is currently
        unencrypted at rest, so excluding it is the privacy-safe default.
        (Follow-up: re-enable encrypted backup once the DB is migrated to
        SQLCipher with a Keystore-held passphrase — see issue #13.)
      * EncryptedSharedPreferences (jarvis_settings.xml) holds API keys
        and OAuth tokens. The AES master key lives in the Android KeyStore
        which is per-device and does NOT survive backup/transfer, so a
        restored encrypted prefs file is unreadable. Re-enter keys on a
        new device.
      * Anything under files/ (TFLite models, recordings, image outputs)
        is re-downloadable or regenerated locally.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Non-encrypted SharedPreferences the presence + learning layer use. -->
        <include domain="sharedpref" path="jarvis_known_ssids.xml" />
        <include domain="sharedpref" path="jarvis_action_ledger.xml" />
        <include domain="sharedpref" path="jarvis_conversation_threads.xml" />
        <include domain="sharedpref" path="jarvis_routine_synth.xml" />

        <!-- Hard excludes: sensitive DB (transcripts, facts, voice embeddings),
             encrypted prefs, and all local files must never be captured. -->
        <exclude domain="database" path="jarvis.db" />
        <exclude domain="database" path="jarvis.db-wal" />
        <exclude domain="database" path="jarvis.db-shm" />
        <exclude domain="sharedpref" path="jarvis_settings.xml" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref" path="jarvis_known_ssids.xml" />
        <include domain="sharedpref" path="jarvis_action_ledger.xml" />
        <include domain="sharedpref" path="jarvis_conversation_threads.xml" />
        <include domain="sharedpref" path="jarvis_routine_synth.xml" />
        <exclude domain="database" path="jarvis.db" />
        <exclude domain="database" path="jarvis.db-wal" />
        <exclude domain="database" path="jarvis.db-shm" />
        <exclude domain="sharedpref" path="jarvis_settings.xml" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
